# ----LLM Providers ----
GEMINI_API_KEY=
GROQ_API_KEY=
DRAFT_MODEL=openai/gpt-oss-20b


# fine-tuned LLM
FINETUNED_MODEL_URL=https://your-space.hf.space/v1
FINETUNED_MODEL_API_KEY=not-needed
CLASSIFIER_TIMEOUT=8  


FINETUNED_MODEL_API_KEY=
FINETUNED_MODEL_URL=https://<your-space-direct-url>.hf.space/v1
CLASSIFIER_TIMEOUT=8


SANDBOX_ENABLED=false


# ----- POSTGRES (ticket archive, account/billing DB) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=triage_agent
POSTGRES_USER=triage
POSTGRES_PASSWORD=changeme
POSTGRES_URL=postgresql://triage:PASSWORD@localhost:5432/triage_agent


# --- DB with dedicated ROLES
READONLY_DB_USER=new_db_username
READONLY_DB_PASSWORD=database_password
READONLY_DATABASE_URL=postgresql://triage_readonly:PASSWORD@localhost:5432/triage_agent


# ----- Redis (Langgraph Checkpointing) ----
REDIS_URL=redis://:PASSWORD@localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=


# ----- APP -----
APP_ENV=production
LOG_LEVEL=info
API_KEY=                    


# ----- Public demo -----
DEMO_MODE=true              
RATE_LIMIT_PER_MIN=8
DAILY_CAP=300
CORS_ORIGINS=               